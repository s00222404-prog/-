PORT=3001
DATABASE_URL=postgres://postgres:password@localhost:5432/vibe
# Optional PostgreSQL connection pool size (integer 1–50; default 10)
DATABASE_POOL_MAX=10
BOT_TOKEN=replace_with_bot_token
# Optional stable Telegram webhook secret; if omitted, the server generates one at startup.
# TELEGRAM_WEBHOOK_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# Stripe Identity (never expose secret keys in the client)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_RETURN_URL=https://your-mini-app.example/age-verification-return

# Comma-separated Telegram numeric IDs allowed to access /admin (never set this in the client)
ADMIN_TELEGRAM_IDS=123456789
